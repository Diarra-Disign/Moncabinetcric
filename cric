#!/bin/bash
#
# Lanceur des commandes d'administration.
#
#   ./cric                      liste les commandes
#   ./cric inviter --email=…    invite quelqu'un
#
# Raison d'être : sur cette machine, node n'est pas dans le PATH d'un
# terminal ordinaire — il vit uniquement dans .local-node/bin. Toute
# commande « node scripts/… » y échoue en « command not found ». Ce
# lanceur pose le chemin une fois pour toutes.

set -euo pipefail

RACINE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$RACINE/.local-node/bin:$PATH"
cd "$RACINE"

if ! command -v node >/dev/null 2>&1; then
  echo "node introuvable, y compris dans .local-node/bin." >&2
  exit 1
fi

commande="${1:-}"
shift || true

case "$commande" in
  inviter)      exec node scripts/invite.mjs "$@" ;;
  abonnement)   exec node scripts/manage-subscription.mjs "$@" ;;
  admin)        exec node scripts/grant-platform-admin.mjs "$@" ;;
  comptes)      exec node scripts/setup-accounts.mjs "$@" ;;
  cabinet)      exec node scripts/reset-firm.mjs "$@" ;;
  verifier)     exec node scripts/verify-auth.mjs "$@" ;;
  roles)        exec node scripts/verify-roles.mjs "$@" ;;
  connecteur)   exec node scripts/verify-connector.mjs "$@" ;;
  membres)      exec node scripts/verify-members.mjs "$@" ;;
  permissions)  exec node scripts/verify-permissions.mjs "$@" ;;
  sieges)       exec node scripts/verify-seats.mjs "$@" ;;
  fideicommis)  exec node scripts/verify-trust.mjs "$@" ;;
  documents)    exec node scripts/verify-requirements.mjs "$@" ;;
  echeances)    exec node scripts/verify-deadlines.mjs "$@" ;;
  portail-client) exec node scripts/verify-portal.mjs "$@" ;;
  formulaires)  exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/verify-forms.mjs "$@" ;;
  mobile)       exec node scripts/verify-mobile.mjs "$@" ;;
  fiche)        exec node scripts/verify-matter-page.mjs "$@" ;;
  questionnaires) exec node scripts/verify-questionnaires.mjs "$@" ;;
  repondre)     exec node scripts/verify-questionnaire-page.mjs "$@" ;;
  courriel)     exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/verify-courriel.mjs "$@" ;;
  envoi)        exec node scripts/verify-envoi.mjs "$@" ;;
  contraste)    exec node scripts/verify-contraste.mjs "$@" ;;
  ententes)     exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/verify-ententes.mjs "$@" ;;
  parametres)   exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/verify-parametres.mjs "$@" ;;
  signature)    exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/verify-signature.mjs "$@" ;;
  onglet-signature) exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/verify-onglet-signature.mjs "$@" ;;
  bandeau)      exec node scripts/verify-bandeau.mjs "$@" ;;
  dossier-client) exec node scripts/verify-dossier-client.mjs "$@" ;;
  facturation-lignes) exec node scripts/verify-facturation.mjs "$@" ;;
  facturation-globale) exec node scripts/verify-facturation-globale.mjs "$@" ;;
  capture)      exec node scripts/capturer.mjs "$@" ;;
  rapprochement) exec node scripts/verify-fideicommis.mjs "$@" ;;
  facture-pdf)  exec node scripts/verify-facture-pdf.mjs "$@" ;;
  modeles)      exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/generer-modeles-questionnaires.mjs "$@" ;;
  facturation)  exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/verify-billing.mjs "$@" ;;
  facturation-sieges) exec node --experimental-strip-types --import ./scripts/_charger.mjs scripts/verify-seat-billing.mjs "$@" ;;
  portail)      exec node scripts/portail-stripe.mjs "$@" ;;
  stripe-config) exec node scripts/stripe-config.mjs "$@" ;;
  migration)    exec node scripts/apply-migration.mjs "$@" ;;
  provisionner) exec node scripts/provision-project.mjs "$@" ;;
  motdepasse)   exec node scripts/set-password.mjs "$@" ;;
  cle)          exec node scripts/set-service-key.mjs "$@" ;;
  cle-test)     exec node scripts/set-stripe-test-key.mjs "$@" ;;
  legislation)  exec node scripts/import-legislation.mjs "$@" ;;
  test)         exec pnpm test "$@" ;;
  dev)          exec npm run dev ;;
  ""|aide|-h|--help)
    cat <<'AIDE'
Usage : ./cric <commande> [options]

  inviter      Créer, lister ou révoquer une invitation
                 ./cric inviter
                 ./cric inviter --email=confrere@cabinet.ca --firm=R000000 --role=rcic
                 ./cric inviter --revoke=confrere@cabinet.ca --firm=R000000

  abonnement   Plans et accès des cabinets
                 ./cric abonnement
                 ./cric abonnement --firm=R000000 --suspend
                 ./cric abonnement --firm=R000000 --activate

  facturation  Éprouver le verrou de facturation : l'accès suit-il
               réellement l'état de l'abonnement ?
                 ./cric facturation

  portail      Configuration du portail client Stripe : moyen de paiement,
               factures, résiliation. Sans elle, le bouton « Gérer » échoue.
               Sans --appliquer, montre ce qu'il ferait sans rien écrire.
                 ./cric portail --site=https://moncabinetcric.com
                 ./cric portail --site=https://moncabinetcric.com --appliquer

  stripe-config  Mise en ordre du compte Stripe. --webhook recrée le point de
               terminaison sur l'adresse publique et pose son secret neuf dans
               .env.local ; --liens désactive les liens de paiement et archive
               les tarifs hors catalogue ; --fiscal pose le code fiscal SaaS ;
               --acss propose le prélèvement préautorisé une fois agréé.
               Sans --appliquer, montre sans écrire.
                 ./cric stripe-config --liens --fiscal --acss
                 ./cric stripe-config --webhook --site=https://... --appliquer

  admin        Administrateurs de la plateforme
                 ./cric admin
                 ./cric admin --grant=courriel@exemple.ca

  motdepasse   Poser ou changer le mot de passe d'un compte
                 ./cric motdepasse
                 ./cric motdepasse --email=infos@dgvimmigration.com

  provisionner Remonte toute la plateforme sur un projet Supabase neuf
                 ./cric provisionner            (simulation)
                 ./cric provisionner --apply

  migration    Applique un fichier SQL et échoue si Postgres refuse
                 ./cric migration supabase/migrations/2026....sql

  verifier     Diagnostic : clés, comptes, fermeture de la base
  roles        Éprouve la matrice des droits en base
  connecteur   Éprouve le cloisonnement du connecteur IA par cabinet
  fideicommis  Éprouve les paiements et le registre de fidéicommis
  echeances    Éprouve les échéances du dossier et les alertes du cabinet
  portail-client  Éprouve le dépôt de pièces par le client et la validation
  formulaires  Éprouve les formulaires officiels : pré-remplissage, versions,
               et remplissage d’un PDF à champs
  documents    Éprouve les pièces exigées : reçu ≠ vérifié, et le blocage
               d’un dossier incomplet
  mobile       Éprouve le rendu sur écran de téléphone : tiroir de navigation
               et débordement de la barre supérieure

  fiche        Ouvre réellement la fiche complète d'un dossier dans un
               navigateur et refuse une page d'erreur. Une table absente en
               base ne se voit dans aucun test unitaire : elle ne se voit
               qu'ici.
                 ./cric fiche
                 ./cric fiche --url=http://localhost:3001

  questionnaires  Éprouve la bibliothèque de questionnaires : envoi à un
               prospect sans compte, lien sécurisé, statut calculé,
               cloisonnement entre cabinets
                 ./cric questionnaires

  repondre     Ouvre un vrai questionnaire par son lien dans un navigateur et
               compte les zones de réponse, section par section. Un champ
               peut exister en base sans qu'aucune branche du composant ne le
               rende : cela ne se verrait qu'à l'usage.
                 ./cric repondre
                 ./cric repondre --url=http://localhost:3001

  envoi        Reproduit le clic sur « Envoyer » dans un navigateur et
               rapporte ce que l'écran répond, en plus de l'état de la base.
                 ./cric envoi
                 ./cric envoi --url=https://moncabinetcric.com

  bandeau      Éprouve le bandeau d'échéances du tableau de bord sur trois
               situations réelles : aucune, une à 20 jours, une à 5 jours.
                 ./cric bandeau

  contraste    Mesure le contraste réel des pastilles de statut sous les
               cinq thèmes de cabinet, couleurs composées par le navigateur.
                 ./cric contraste

  onglet-signature
               Ouvre l'onglet Signature d'un dossier dans un vrai navigateur,
               envoie une demande et vérifie qu'elle s'affiche ensuite.
                 ./cric onglet-signature

  courriel     Éprouve la fabrication de l'en-tête « De » : nom du cabinet
               recollé sur l'adresse d'expédition sans la casser
                 ./cric courriel

  modeles      Régénère l'amorçage des modèles depuis le catalogue
               TypeScript. Écrit sur la sortie standard.
                 ./cric modeles > supabase/migrations/…_seed.sql
  comptes      Met en place les cabinets et comptes de départ
  cabinet      Purge les données de démonstration, écrit l'identité réelle
  cle          Enregistre la clé de service Supabase
  legislation  Réimporte la LIPR et le RIPR
  test         Suite de tests
  dev          Démarre le serveur de développement

Les identifiants de cabinet sont les numéros de permis :
AIDE
    node -e '
      const { readFileSync } = require("fs")
      const env = Object.fromEntries(readFileSync(".env.local","utf8").split("\n")
        .map(l=>l.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*)$/)).filter(Boolean)
        .map(m=>[m[1],m[2].trim().replace(/^["\x27]|["\x27]$/g,"")]))
      const { createClient } = require("@supabase/supabase-js")
      createClient(env.NEXT_PUBLIC_SUPABASE_URL, env.SUPABASE_SERVICE_ROLE_KEY,
        {auth:{persistSession:false}})
        .from("firms").select("name, rcic_license_number").then(({data}) => {
          for (const f of data ?? []) console.log(`  ${f.rcic_license_number.padEnd(11)} ${f.name}`)
        })
    ' 2>/dev/null || echo "  (base non jointe)"
    ;;
  *)
    echo "Commande « $commande » inconnue. Lancez ./cric pour la liste." >&2
    exit 1
    ;;
esac
