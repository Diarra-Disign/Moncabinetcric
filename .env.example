# =====================================================================
# moncabinetcric — variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs.
# .env* est ignoré par Git : ne jamais committer .env.local.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Tableau de bord > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://zpbkxzrnvzxcwlhjllrp.supabase.co

# Clé publique. Exposée au navigateur : elle est conçue pour ça et n'a de
# valeur qu'associée aux politiques RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service. CONTOURNE ENTIÈREMENT RLS.
# Ne jamais la préfixer NEXT_PUBLIC_, ne jamais l'importer dans un
# composant client. Utilisée uniquement par lib/supabase/server.ts,
# dans des Server Components et des Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Source de données ------------------------------------------------
# "mock" (défaut) : l'application tourne sur lib/data/mock/, aucun accès
#                   réseau, comportement identique à aujourd'hui.
# "supabase"      : lecture et écriture sur la base réelle.
# Tant que le schéma n'est pas appliqué et peuplé, laisser sur "mock".
DATA_SOURCE=mock

# --- Cabinet actif ----------------------------------------------------
# Tant que l'authentification n'est pas branchée, le cabinet courant est
# fixé par cette variable plutôt que déduit de la session.
# Correspond à firms.slug dans la base.
ACTIVE_FIRM_SLUG=firm-boreale

# ---------------------------------------------------------------------------
# Envoi des courriels transactionnels (invitations d'accès)
# ---------------------------------------------------------------------------
# Sans ces deux variables, l'application n'envoie rien : la console affiche
# le lien d'accès à recopier. Rien n'est perdu, c'est seulement moins fluide.
#
# RESEND_API_KEY : https://resend.com → API Keys
# EMAIL_FROM     : adresse d'un domaine vérifié chez Resend, sinon les
#                  messages partent en indésirable ou sont refusés.
RESEND_API_KEY=
EMAIL_FROM="Mon Cabinet CRIC <acces@exemple.ca>"

# Adresse à laquelle les réponses doivent parvenir. L'expéditeur ci-dessus
# n'est pas une boîte de réception : Resend signe en son nom, rien ne
# l'écoute. Sans cette variable, le courriel n'invite pas à répondre —
# plutôt que d'envoyer le destinataire écrire dans le vide.
EMAIL_REPLY_TO=

# Origine des liens envoyés par courriel. Un lien relatif n'a aucun sens
# dans une boîte de réception.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Facturation récurrente (Stripe)
# ---------------------------------------------------------------------------
# Sans ces variables, l'écran d'abonnement s'affiche mais refuse d'ouvrir le
# paiement, en le disant. Rien d'autre n'est affecté : un cabinet en essai ou
# en courtoisie continue de travailler normalement.
#
# STRIPE_SECRET_KEY : tableau de bord Stripe > Développeurs > Clés d'API.
#   « sk_test_… » pour éprouver, « sk_live_… » pour encaisser. Ne jamais la
#   préfixer NEXT_PUBLIC_ : elle autorise à débiter au nom du compte.
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET : signature des événements reçus sur
#   /api/stripe/webhook. Obtenue en déclarant l'adresse dans
#   Développeurs > Webhooks, ou en local avec « stripe listen ».
#
#   Cette variable N'EST PAS optionnelle en production. Sans elle, la route
#   répond 503 à tout : c'est voulu — une adresse qui accepterait des
#   événements non signés laisserait n'importe qui se déclarer abonné,
#   c'est-à-dire s'ouvrir l'accès à l'application.
#
#   Événements à souscrire :
#     checkout.session.completed
#     customer.subscription.created / updated / deleted / paused / resumed
#     invoice.payment_succeeded
#     invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# STRIPE_AUTOMATIC_TAX : « 1 » pour que Stripe calcule TPS/TVH/TVQ selon la
#   province du cabinet. À n'activer qu'une fois l'inscription fiscale
#   déclarée dans Stripe Tax : sans elle, Stripe refuse la session et le
#   paiement échoue sans que le message dise pourquoi. Laissé vide, les
#   montants sont facturés hors taxes.
STRIPE_AUTOMATIC_TAX=

# STRIPE_ACSS_DEBIT : « 1 » pour proposer le prélèvement préautorisé canadien
#   à côté de la carte. À n'activer qu'une fois le moyen ACTIVÉ dans Stripe
#   (Paramètres > Moyens de paiement > Débit préautorisé canadien), qui
#   demande un court formulaire et une validation. Demandé avant, Stripe
#   refuse la session entière — donc même le paiement par carte.
#   Il vaut la peine : 1 % plafonné contre 2,9 % + 0,30 $, et un compte
#   bancaire n'expire pas. Laissé vide, seule la carte est proposée.
STRIPE_ACSS_DEBIT=
