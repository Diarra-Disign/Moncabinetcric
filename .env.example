# =====================================================================
# moncabinetcric — variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs.
# .env* est ignoré par Git : ne jamais committer .env.local.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Tableau de bord > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://zpbkxzrnvzxcwlhjllrp.supabase.co

# Clé publique. Exposée au navigateur : elle est conçue pour ça et n'a de
# valeur qu'associée aux politiques RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service. CONTOURNE ENTIÈREMENT RLS.
# Ne jamais la préfixer NEXT_PUBLIC_, ne jamais l'importer dans un
# composant client. Utilisée uniquement par lib/supabase/server.ts,
# dans des Server Components et des Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Source de données ------------------------------------------------
# "mock" (défaut) : l'application tourne sur lib/data/mock/, aucun accès
#                   réseau, comportement identique à aujourd'hui.
# "supabase"      : lecture et écriture sur la base réelle.
# Tant que le schéma n'est pas appliqué et peuplé, laisser sur "mock".
DATA_SOURCE=mock

# --- Cabinet actif ----------------------------------------------------
# Tant que l'authentification n'est pas branchée, le cabinet courant est
# fixé par cette variable plutôt que déduit de la session.
# Correspond à firms.slug dans la base.
ACTIVE_FIRM_SLUG=firm-boreale

# ---------------------------------------------------------------------------
# Envoi des courriels transactionnels (invitations d'accès)
# ---------------------------------------------------------------------------
# Sans ces deux variables, l'application n'envoie rien : la console affiche
# le lien d'accès à recopier. Rien n'est perdu, c'est seulement moins fluide.
#
# RESEND_API_KEY : https://resend.com → API Keys
# EMAIL_FROM     : adresse d'un domaine vérifié chez Resend, sinon les
#                  messages partent en indésirable ou sont refusés.
RESEND_API_KEY=
EMAIL_FROM="Mon Cabinet CRIC <acces@exemple.ca>"

# Adresse à laquelle les réponses doivent parvenir. L'expéditeur ci-dessus
# n'est pas une boîte de réception : Resend signe en son nom, rien ne
# l'écoute. Sans cette variable, le courriel n'invite pas à répondre —
# plutôt que d'envoyer le destinataire écrire dans le vide.
EMAIL_REPLY_TO=

# Origine des liens envoyés par courriel. Un lien relatif n'a aucun sens
# dans une boîte de réception.
APP_URL=http://localhost:3000
